    <footer class="py-8 text-center text-slate-500 text-sm mt-auto border-t border-slate-800/50 backdrop-blur-sm bg-slate-900/30">
        <p>&copy; 2026 AI Learning Hub. Created for educational purposes.</p>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('quiz-form');
            const submitContainer = document.getElementById('submit-container');
            const resultsSection = document.getElementById('quiz-results');
            const scoreDisplay = document.getElementById('score-display');
            const feedbackMessage = document.getElementById('feedback-message');
            const retryBtn = document.getElementById('retry-btn');

            // Define correct answers mapped to input names
            const correctAnswers = {
                q1: 'B',
                q2: 'B',
                q3: 'C'
            };

            // Form submission logic
            form.addEventListener('submit', (e) => {
                e.preventDefault(); // Prevent page refresh
                
                let score = 0;
                
                // Get the submitted form data
                const formData = new FormData(form);
                
                // Calculate score by comparing to correct answers
                for (const [question, answer] of Object.entries(correctAnswers)) {
                    const selectedAnswer = formData.get(question);
                    if (selectedAnswer === answer) {
                        score++;
                    }
                }

                // Display score
                scoreDisplay.textContent = `${score} / 3`;

                // Generate friendly feedback
                if (score === 3) {
                    feedbackMessage.textContent = "Perfect! You're an AI expert in the making!";
                    feedbackMessage.className = "text-xl font-medium text-green-400 mt-4";
                } else if (score === 2) {
                    feedbackMessage.textContent = "Great job! You have a solid understanding of AI.";
                    feedbackMessage.className = "text-xl font-medium text-blue-400 mt-4";
                } else {
                    feedbackMessage.textContent = "Good try! Review the cards above and give it another shot.";
                    feedbackMessage.className = "text-xl font-medium text-purple-400 mt-4";
                }

                // Hide the form submit button and reveal the results block
                submitContainer.classList.add('hidden');
                resultsSection.classList.remove('hidden');
                
                // Smooth scroll down to the results
                setTimeout(() => {
                    resultsSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }, 100);
            });

            // Retry button logic
            retryBtn.addEventListener('click', () => {
                // Reset radio button selections
                form.reset();
                
                // Hide results and show submit button again
                resultsSection.classList.add('hidden');
                submitContainer.classList.remove('hidden');
                
                // Scroll back to the top of the quiz
                document.getElementById('quiz-section').scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
        });
    </script>
